# Set these in your host's environment-variable settings (or `export` them locally).
# The app does not read .env files. Never commit a real key.
ANTHROPIC_API_KEY=
# Defaults, shown here. Sonnet 5.5 matched the Opus answer on the sample; Haiku (claude-haiku-5-5) is ~20x cheaper but did not.
MODEL=claude-sonnet-5-5
EFFORT=low
VOTES=3
MAX_SCENE_CHARS=8000
RATE_LIMIT=3 per hour
DAILY_REQUEST_CAP=100
# Number of reverse proxies in front of the app, so the rate limit sees real client IPs. Leave 0 if none.
TRUST_PROXY_HOPS=0
